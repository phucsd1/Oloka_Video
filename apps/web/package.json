{
  "name": "@oloka/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @oloka/contracts && npm run build -w @oloka/design-system",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @oloka/contracts && npm run build -w @oloka/design-system",
    "test": "vitest run"
  },
  "dependencies": {
    "@oloka/contracts": "0.1.0",
    "@oloka/design-system": "0.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
