{
  "name": "@oloka/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build -w @oloka/contracts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run build -w @oloka/contracts",
    "test:unit": "npm run build -w @oloka/contracts && vitest run --exclude **/*.integration.test.ts",
    "test:integration": "npm run build -w @oloka/contracts && vitest run --exclude **/*.unit.test.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@oloka/contracts": "0.1.0",
    "canonicalize": "3.0.0",
    "fastify": "5.11.2",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "tsx": "4.20.3",
    "vitest": "3.2.7"
  }
}
