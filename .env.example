NODE_ENV=development
PORT=7860
DATABASE_PATH=/absolute/local/path/oloka.db
OBJECT_STORAGE_ROOT=/absolute/persistent/object-storage
HF_S3_ENDPOINT=https://s3.hf.co/phucsd
HF_S3_REGION=us-east-1
HF_S3_BUCKET=oloka-video-dev-data
HF_S3_SQLITE_PREFIX=sqlite-replica/dev
OLOKA_DATABASE_BOOTSTRAP_MODE=fresh-if-replica-missing
APP_VERSION=0.1.0
GIT_COMMIT_SHA=local
BUILD_TIMESTAMP=development
LOG_LEVEL=info
# Required before upgrading any existing database. Generate 32 random bytes and
# encode them as canonical unpadded base64url; store the value only as a secret.
# OLOKA_APP_KEY=
# Google OIDC and closed-beta identity configuration. Only the client secret is
# a provider secret; keep CSRF/session/OAuth material out of environment files.
OLOKA_GOOGLE_OIDC_ISSUER=https://accounts.google.com
OLOKA_GOOGLE_CLIENT_ID=replace-with-google-client-id
# OLOKA_GOOGLE_CLIENT_SECRET=
OLOKA_PUBLIC_ORIGIN=https://replace-with-public-origin.example
OLOKA_BOOTSTRAP_ADMIN_EMAIL=replace-with-verified-admin@example.com
OLOKA_SESSION_IDLE_TTL_SECONDS=604800
OLOKA_SESSION_ABSOLUTE_TTL_SECONDS=2592000
OLOKA_OAUTH_TRANSACTION_TTL_SECONDS=600
# Required only for the production Litestream process. Store values as secrets.
# HF_S3_ACCESS_KEY_ID=
# HF_S3_SECRET_ACCESS_KEY=
